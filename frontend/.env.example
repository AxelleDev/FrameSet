# Frontend API endpoint
VITE_API_URL=

# Public site origin, used for SEO canonical / Open Graph / sitemap URLs
# (e.g. https://frameset-taupe.vercel.app). No trailing slash.
VITE_SITE_URL=

# Google Sign-In ("Continue with Google"). Same OAuth 2.0 Web client ID as the
# backend's GOOGLE_CLIENT_ID (client IDs are public by design). Optional: leave
# empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# Error monitoring (Sentry) — optional. DSN of a sentry.io React project (DSNs
# are public by design). When set at build time, uncaught errors and crashes
# caught by the project ErrorBoundary are reported; leave empty to disable
# (the SDK is then never even downloaded by the browser).
VITE_SENTRY_DSN=