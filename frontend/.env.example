# Frontend API endpoint
VITE_API_URL=

# Public site origin, used for SEO canonical / Open Graph / sitemap URLs
# (e.g. https://frameset.app). No trailing slash.
VITE_SITE_URL=

# Google Sign-In ("Continue with Google"). Same OAuth 2.0 Web client ID as the
# backend's GOOGLE_CLIENT_ID (client IDs are public by design). Optional: leave
# empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=