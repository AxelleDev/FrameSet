# Server config
# In production set NODE_ENV=production: it enables secure cookies, HSTS, JSON
# logs, and makes SMTP config mandatory. Leave unset in development.
# NODE_ENV=production
# Origin of the frontend, used for CORS and cookies (e.g. http://localhost:5173).
# REQUIRED in production (the app refuses to boot without it).
FRONTEND_ORIGIN=
PORT=3000
# Interactive API docs (Swagger UI) at /api-docs. On by default in development; in
# production they are opt-in — set to "true" to expose them, otherwise hidden.
ENABLE_API_DOCS=true

# Database configuration (MySQL or MariaDB).
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=frameset_db

# Database backups (npm run backup) — optional overrides. Backups are gzipped
# SQL dumps written to backend/backups/ by default and pruned after 14 days;
# schedule the command with cron / Task Scheduler (see README "Backups").
# BACKUP_DIR=/var/backups/frameset
# BACKUP_RETENTION_DAYS=14

# Email configuration. Two delivery paths — configure ONE in production:
#
# A) Brevo HTTP API (RECOMMENDED, and required on hosts that block outbound SMTP
#    such as Railway, Render, Fly, ...). Emails are sent over HTTPS, never SMTP.
#    - Create a v3 API key in Brevo (SMTP & API > API Keys) and paste it below.
#    - Set MAIL_FROM_ADDRESS to an address VALIDATED as a sender in Brevo
#      (Senders, Domains & Dedicated IPs > Senders). The smtp-brevo.com SMTP
#      login is NOT a valid sender for the API.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
#
# B) SMTP (only where outbound SMTP ports are open). Any provider works.
#    - In DEVELOPMENT you can leave A and B EMPTY: the app auto-creates an
#      Ethereal test account on first send and logs a preview URL to the console
#      (nothing reaches real inboxes). Clone, run, done — no email setup needed.
#    - In PRODUCTION, either BREVO_API_KEY (A) or the full SMTP config (B) is
#      REQUIRED (the app refuses to boot otherwise).
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=

# JWT configuration — use long random strings, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production each secret must be at least 32 characters (enforced at boot).
JWT_SECRET=
JWT_REFRESH_SECRET=

# Bcrypt salt rounds (cost factor). 12 is a good default.
BCRYPT_SALT_ROUNDS=12

# Logging level (debug | info | warn | error)
LOG_LEVEL=info

# Error monitoring (Sentry) — optional. Create a (free-tier) Node.js project on
# sentry.io and paste its DSN here to have every 5xx / crash reported with its
# request id. Leave empty to disable (the app runs identically without it).
SENTRY_DSN=
# Optional environment tag for Sentry events; defaults to NODE_ENV.
# SENTRY_ENVIRONMENT=production

# Google Fonts Developer API key, used server-side to proxy the font catalog
# (GET /api/fonts) so the key never ships in the client bundle. Restrict it in
# the Google Cloud console to the "Web Fonts Developer API". Optional: the font
# picker simply stays empty if unset.
GOOGLE_FONTS_API_KEY=

# Google Sign-In ("Continue with Google"). OAuth 2.0 Web client ID created in the
# Google Cloud console (APIs & Services > Credentials), with your frontend origin
# listed under "Authorized JavaScript origins". Must match the frontend's
# VITE_GOOGLE_CLIENT_ID. Optional: leave empty to disable Google sign-in
# (the endpoint answers 503 and the frontend hides the button).
GOOGLE_CLIENT_ID=
